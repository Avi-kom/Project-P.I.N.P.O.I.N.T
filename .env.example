# Copy this file to .env.local and fill in real values from your Supabase project settings.

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — server-side only, NEVER prefix with NEXT_PUBLIC_,
# never expose to the browser. Used only in API routes/server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
